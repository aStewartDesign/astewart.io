{% set body_class = "home" %}
{% extends "template-parts/_layout.njk" %}

{% block content %}

<header class="c-header">
    <div class="o-main-grid">
        <h1 class="c-header__title">
            Hi, <span class="c-header__title-span">I'm Andrew.</span>
        </h1>
        <p class="c-header__intro">
            I'm a senior software engineer with <span id="experience">{{ yearsExperience }}</span> years of experience building intuitive products from the UI to the API.
        </p>
    </div>
</header>

<div class="o-main-grid">
    <div class="c-about c-section">
        <p>With my software engineering experience and design background, I transform loose design requirements into well-rounded features that deliver value to the user and scale efficiently. My experience from small startup to corporate acquisition has provided me with a broad skill set from building backend API endpoints and integrating with third party applications to maintaining a component library and creating intuitive user interfaces.</p>
        <p>My experiences include:</p>
        <ul class="c-list">
            <li class="c-list__item"><span class="c-list__item-text">Developing AI-powered features using LLM integrations and custom ML models</span></li>
            <li class="c-list__item"><span class="c-list__item-text">Modernizing infrastructure through cloud migrations and service integrations</span></li>
            <li class="c-list__item"><span class="c-list__item-text">Building applications across the stack, from database design to responsive frontends</span></li>
            <li class="c-list__item"><span class="c-list__item-text">Architecting design systems and component libraries for enterprise applications</span></li>
        </ul>
        <a href="/images/aStewartResume.pdf" class="c-button" target="_blank">Download my resume <i class="fas fa-download"></i></a>
    </div>

    <section class="experience c-section">
        <h2 id="experience" class="c-section__title">Experience</h2>

        <div class="c-experiences">
        {% for experience in experiences | reverse %}
            {% include "template-parts/_experience.njk" %}
        {% endfor %}
        </div>
    </section>

    <section class="skills c-section">
        <h2 id="skills" class="c-section__title">Skills</h2>
        <h3 class="c-section__header">Technical</h3>
        <ul>
        {% for skillGroup in skills.technical %}
            {% include "template-parts/_skill-group.njk" %}
        {% endfor %}
        </ul>
        <h3 class="c-section__header">Design</h3>
        <ul>
        {% for skillGroup in skills.design %}
            {% include "template-parts/_skill-group.njk" %}
        {% endfor %}
        </ul>
        <h3 class="c-section__header">Soft</h3>
        <ul>
        {% for skillGroup in skills.soft %}
            {% include "template-parts/_skill-group.njk" %}
        {% endfor %}
        </ul>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const experienceElement = document.getElementById('experience');
        if (experienceElement) {
            // Calculate years of experience from June 2011 to current date to
            // keep it dynamic and up-to-date
            const experienceStartDate = new Date('2011-06-01T00:00:00');
            const currentDate = new Date();
            const years =
                currentDate.getFullYear() - experienceStartDate.getFullYear();
            experienceElement.textContent = years;
        }
    });
</script>

{% endblock %}
